# ==============================================================================
# AegisCortex AI - Snowflake & Environment Configuration
# ==============================================================================

# Snowflake Connection Parameters
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AEGIS_CORTEX_DB
SNOWFLAKE_SCHEMA=APP

# Optional Key Pair Authentication (if preferred over password)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model Context Protocol (MCP) Simulated Webhook Endpoints
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/ALERT/WEBHOOK
JIRA_INSTANCE_URL=https://mock-healthsystem.atlassian.net
